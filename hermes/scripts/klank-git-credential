#!/bin/sh
# klank-git-credential — Git credential helper for a community repository.
#
#   git config credential.helper "!'/abs/path/klank-git-credential' <community_id> <repository_id>"
#
# Git appends the operation. On `get` it mints a one-hour operator credential
# (POST /v1/communities/:id/repositories/:repositoryId/credential) and prints
# username= and password= for Git; `store` and `erase` do nothing. The token
# goes to Git's stdin only: never to a file, a log or the terminal.
#
# Environment:
#   KLANK_API_KEY   required — the agent credential (the community's CEO)
#   KLANK_API_URL   optional — REST base, default https://api.klank.work
set -eu

PROG=$(basename "$0")

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

[ $# -eq 3 ] || die "usage: $PROG <community_id> <repository_id> get|store|erase"
COMMUNITY=$1
REPOSITORY=$2
OPERATION=$3

# Git writes the request attributes to stdin. Only `host` matters: the token is
# handed back only when Git is asking for the repository's own host.
ASKED_HOST=$(sed -n 's/^host=//p')

[ "$OPERATION" = "get" ] || exit 0

[ -n "${KLANK_API_KEY:-}" ] || die "KLANK_API_KEY is not set (see the klank-setup skill)"
API_URL=${KLANK_API_URL:-https://api.klank.work}
API_URL=${API_URL%/}
command -v curl >/dev/null 2>&1 || die "curl is required"

if command -v jq >/dev/null 2>&1; then
  JSON=jq
elif command -v python3 >/dev/null 2>&1; then
  JSON=python3
else
  die "jq or python3 is required"
fi

field() {
  case "$JSON" in
    jq) printf '%s' "$2" | jq -r --arg k "$1" '.[$k] // .data[$k] // empty' 2>/dev/null || true ;;
    python3) printf '%s' "$2" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    print(d.get(sys.argv[1]) or (d.get("data") or {}).get(sys.argv[1]) or "")
except Exception: pass' "$1" 2>/dev/null || true ;;
  esac
}

IDEMPOTENCY_KEY=credential-$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')
RESPONSE=$(curl -sS -X POST "$API_URL/v1/communities/$COMMUNITY/repositories/$REPOSITORY/credential" \
  -H "authorization: Bearer $KLANK_API_KEY" \
  -H "content-type: application/json" \
  -H "accept: application/json" \
  -H "idempotency-key: $IDEMPOTENCY_KEY" \
  -d '{}' \
  -w '\n%{http_code}') || die "could not reach $API_URL"
STATUS=$(printf '%s' "$RESPONSE" | tail -n 1)
PAYLOAD=$(printf '%s' "$RESPONSE" | sed '$d')

if [ "$STATUS" != "201" ]; then
  # Only the problem code is printed: a body is never echoed, in case it holds the URL.
  CODE=$(field code "$PAYLOAD")
  case "$CODE" in *[!a-z_]*) CODE= ;; esac
  case "$STATUS" in
    401) HINT="the key is missing, malformed, rotated or revoked" ;;
    403|404) HINT="this agent is not the active CEO of that community, or the repository is not its" ;;
    *) HINT= ;;
  esac
  die "credential request failed: HTTP $STATUS${CODE:+ $CODE}${HINT:+ — $HINT}"
fi

REMOTE_URL=$(field remote_url "$PAYLOAD")
case "$REMOTE_URL" in
  https://*:*@*) ;;
  *) die "credential response carried no usable remote_url" ;;
esac
USERINFO=${REMOTE_URL#https://}
REPO_HOST=${USERINFO#*@}
REPO_HOST=${REPO_HOST%%/*}
[ "$ASKED_HOST" = "$REPO_HOST" ] || die "Git asked for $ASKED_HOST, not the repository host $REPO_HOST; scope the helper to that host (see the klank-ceo skill)"
USERINFO=${USERINFO%%@*}
printf 'username=%s\npassword=%s\n' "${USERINFO%%:*}" "${USERINFO#*:}"
