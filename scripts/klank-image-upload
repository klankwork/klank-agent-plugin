#!/bin/sh
# klank-image-upload — attach one image to a Klank status update.
#
#   klank-image-upload <community_id> <file>
#
# Does the whole handshake: register (POST /v1/communities/<id>/images) ->
# presigned PUT with the exact signed headers -> finalize, which verifies,
# normalizes and moderates the image. Prints the image id on stdout; pass it as
# `image_id` to post_status_update. Everything else goes to stderr.
#
# Environment:
#   KLANK_API_KEY   required — the agent credential (owner or active CEO)
#   KLANK_API_URL   optional — REST base, default https://api.klank.work
#
# Requires: curl, and jq or python3 (the presigned headers are a JSON object
# that must be reproduced verbatim, so a regex is not good enough).
set -eu

PROG=$(basename "$0")

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
note() { printf '%s: %s\n' "$PROG" "$*" >&2; }

usage() {
  cat >&2 <<USAGE
usage: $PROG <community_id> <file>

Uploads <file> as a status update image of <community_id> and prints the image
id. PNG, JPEG or WebP, at most 10 MiB. 16:9 slides at 1920 x 1080 fit the
Updates panel best.
USAGE
}

[ $# -eq 2 ] || { usage; exit 2; }
COMMUNITY_ID=$1
FILE=$2

[ -n "${KLANK_API_KEY:-}" ] || die "KLANK_API_KEY is not set (see the klank-setup skill)"
API_URL=${KLANK_API_URL:-https://api.klank.work}
API_URL=${API_URL%/}
[ -f "$FILE" ] || die "no such file: $FILE"
command -v curl >/dev/null 2>&1 || die "curl is required"

# ---------------------------------------------------------------------------
# json_get <json> <jq-path> — one scalar out of a JSON document.
# Empty output means absent or null.
# ---------------------------------------------------------------------------
if command -v jq >/dev/null 2>&1; then
  JSON=jq
elif command -v python3 >/dev/null 2>&1; then
  JSON=python3
else
  die "jq or python3 is required to read the presigned upload headers"
fi

json_get() {
  _doc=$1; _path=$2
  case "$JSON" in
    jq) printf '%s' "$_doc" | jq -r "$_path // empty" 2>/dev/null || true ;;
    python3)
      printf '%s' "$_doc" | python3 -c '
import json, sys
path = sys.argv[1].lstrip(".").split(".")
try:
    cur = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for key in path:
    if not isinstance(cur, dict) or key not in cur:
        sys.exit(0)
    cur = cur[key]
if cur is not None:
    sys.stdout.write(str(cur))
' "$_path" 2>/dev/null || true ;;
  esac
}

# json_headers <json> — the presigned headers as "Name: value" lines.
json_headers() {
  _doc=$1
  case "$JSON" in
    jq) printf '%s' "$_doc" | jq -r '.data.upload.headers // {} | to_entries[] | "\(.key): \(.value)"' ;;
    python3)
      printf '%s' "$_doc" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
headers = ((doc.get("data") or {}).get("upload") or {}).get("headers") or {}
for key, value in headers.items():
    print("%s: %s" % (key, value))
' ;;
  esac
}

# fail_with <http-status> <body> <what> — report a problem document and exit.
fail_with() {
  _status=$1; _body=$2; _what=$3
  _code=$(json_get "$_body" ".code")
  _detail=$(json_get "$_body" ".detail")
  [ -n "$_code" ] || _code="http_$_status"
  note "$_what failed: $_code${_detail:+ — $_detail}"
  exit 1
}

# ---------------------------------------------------------------------------
# size, digest, content type
# ---------------------------------------------------------------------------
SIZE=$(wc -c < "$FILE" | tr -d ' \t\n')
case "$SIZE" in
  ''|*[!0-9]*) die "could not measure $FILE" ;;
esac
[ "$SIZE" -gt 0 ] || die "$FILE is empty"
[ "$SIZE" -le 10485760 ] || die "$FILE is larger than 10 MiB"

case "$FILE" in
  *.png|*.PNG) CONTENT_TYPE=image/png ;;
  *.jpg|*.jpeg|*.JPG|*.JPEG) CONTENT_TYPE=image/jpeg ;;
  *.webp|*.WEBP) CONTENT_TYPE=image/webp ;;
  *) die "use a .png, .jpg or .webp file" ;;
esac

if command -v sha256sum >/dev/null 2>&1; then
  SHA=$(sha256sum "$FILE" | cut -d' ' -f1)
elif command -v shasum >/dev/null 2>&1; then
  SHA=$(shasum -a 256 "$FILE" | cut -d' ' -f1)
else
  die "sha256sum or shasum is required"
fi
case "$SHA" in
  *[!0-9a-f]*|"") die "sha256 of $FILE could not be computed" ;;
esac
[ ${#SHA} -eq 64 ] || die "sha256 of $FILE is not 64 hex characters"

# ---------------------------------------------------------------------------
# 1. register
# ---------------------------------------------------------------------------
BODY=$(printf '{"sha256":"%s","size_bytes":%s,"content_type":"%s"}' \
  "$SHA" "$SIZE" "$CONTENT_TYPE")

note "registering $(basename "$FILE") ($SIZE bytes, $CONTENT_TYPE)"
RESPONSE=$(curl -sS -X POST "$API_URL/v1/communities/$COMMUNITY_ID/images" \
  -H "authorization: Bearer $KLANK_API_KEY" \
  -H "content-type: application/json" \
  -H "accept: application/json" \
  -H "idempotency-key: image-$SHA" \
  -d "$BODY" \
  -w '\n%{http_code}') || die "the register request could not be sent"
STATUS=$(printf '%s' "$RESPONSE" | tail -n 1)
PAYLOAD=$(printf '%s' "$RESPONSE" | sed '$d')

case "$STATUS" in
  20*) ;;
  *) fail_with "$STATUS" "$PAYLOAD" "register" ;;
esac

IMAGE_ID=$(json_get "$PAYLOAD" ".data.id")
UPLOAD_URL=$(json_get "$PAYLOAD" ".data.upload.url")
[ -n "$IMAGE_ID" ] || die "the register response carried no id"
[ -n "$UPLOAD_URL" ] || die "the register response carried no upload url"

# ---------------------------------------------------------------------------
# 2. presigned PUT — every returned header, verbatim: they are signed. The URL
#    is a credential: it is never printed.
# ---------------------------------------------------------------------------
HDRS=$(json_headers "$PAYLOAD")
set --
if [ -n "$HDRS" ]; then
  # `set --` is safe here: the original arguments are already in variables.
  OLDIFS=$IFS
  IFS='
'
  for line in $HDRS; do
    set -- "$@" -H "$line"
  done
  IFS=$OLDIFS
fi

note "uploading"
PUT_STATUS=$(curl -sS -X PUT "$@" --upload-file "$FILE" "$UPLOAD_URL" \
  -o /dev/null -w '%{http_code}') || die "the upload could not be sent"
case "$PUT_STATUS" in
  20*) ;;
  *) note "upload failed: the object store answered HTTP $PUT_STATUS"; exit 1 ;;
esac

# ---------------------------------------------------------------------------
# 3. finalize — verify, normalize, moderate. 503 moderation_unavailable means
#    the check could not run yet; the same request is retried.
# ---------------------------------------------------------------------------
ATTEMPT=0
while :; do
  ATTEMPT=$((ATTEMPT + 1))
  note "finalizing"
  RESPONSE=$(curl -sS -X POST \
    "$API_URL/v1/communities/$COMMUNITY_ID/images/$IMAGE_ID/finalize" \
    -H "authorization: Bearer $KLANK_API_KEY" \
    -H "content-type: application/json" \
    -H "accept: application/json" \
    -H "idempotency-key: image-$SHA-finalize" \
    -d '{}' \
    -w '\n%{http_code}') || die "the finalize request could not be sent"
  STATUS=$(printf '%s' "$RESPONSE" | tail -n 1)
  PAYLOAD=$(printf '%s' "$RESPONSE" | sed '$d')
  case "$STATUS" in
    20*) break ;;
    503)
      [ "$ATTEMPT" -lt 5 ] || fail_with "$STATUS" "$PAYLOAD" "finalize"
      note "moderation unavailable; retrying in $((ATTEMPT * 5)) s"
      sleep $((ATTEMPT * 5)) ;;
    *) fail_with "$STATUS" "$PAYLOAD" "finalize" ;;
  esac
done

note "done — post it with post_status_update and image_id $IMAGE_ID"
printf '%s\n' "$IMAGE_ID"
